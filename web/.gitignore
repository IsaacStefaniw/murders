# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# Films. The two current cuts are committed deliberately and listed by
# name; anything further belongs in R2 or Cloudflare Stream. Git keeps
# every version of a binary forever, so a re-cut does not replace the old
# blob — it adds to it, and every clone pays for it from then on.
public/video/*.webm
public/video/*.mp4
public/video/*.jpg
!public/video/intentnorth-coaching-45s.webm
!public/video/intentnorth-coaching-45s.mp4
!public/video/intentnorth-coaching-45s-poster.jpg
!public/video/intentnorth-coaching-16s-vertical.webm
!public/video/intentnorth-coaching-16s-vertical.mp4
!public/video/intentnorth-coaching-16s-vertical-poster.jpg
!public/video/intentnorth-intent-45s.webm
!public/video/intentnorth-intent-45s.mp4
!public/video/intentnorth-intent-45s-poster.jpg
!public/video/intentnorth-intent-18s-vertical.webm
!public/video/intentnorth-intent-18s-vertical.mp4
!public/video/intentnorth-intent-18s-vertical-poster.jpg
!public/video/intentnorth-week-30s.webm
!public/video/intentnorth-week-30s.mp4
!public/video/intentnorth-week-30s-poster.jpg
!public/video/intentnorth-week-30s-vertical.webm
!public/video/intentnorth-week-30s-vertical.mp4
!public/video/intentnorth-week-30s-vertical-poster.jpg
!public/video/intentnorth-heard-50s.webm
!public/video/intentnorth-heard-50s.mp4
!public/video/intentnorth-heard-50s-poster.jpg
!public/video/intentnorth-heard-50s-vertical.webm
!public/video/intentnorth-heard-50s-vertical.mp4
!public/video/intentnorth-heard-50s-vertical-poster.jpg
# Nothing that is not media belongs under public/ — the handover README
# deployed to intentnorth.app/video/README.md and sat live with internal
# legal notes in it. The website branch has a build guard for md/txt/log;
# this blocks the sources it does not cover.
public/**/*.py
public/**/*.md
public/**/*.txt
public/**/*.sh
public/**/*.mjs
