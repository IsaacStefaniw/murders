// Deploy target for the website. The worker name must stay
// "intent-operating-system" — that is the live worker; changing it creates a
// second site rather than updating this one.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intent-operating-system",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
