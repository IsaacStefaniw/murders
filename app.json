{
  "expo": {
    "name": "INTENT",
    "slug": "intent-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "intentos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.isaacstefaniw.intentos",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "package": "com.isaacstefaniw.intentos",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "INTENT reads sleep, resting heart rate and weight so your plan adapts to how you actually recovered. Read-only — nothing is written to Health.",
          "NSHealthUpdateUsageDescription": "INTENT does not write to Apple Health and never requests this permission. This notice exists only because the underlying Health framework includes write capabilities.",
          "background": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3E6B58",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9eb10e2-88c8-4bb5-b8b9-20c950431faa"
      }
    },
    "owner": "isaacstefaniw"
  }
}
