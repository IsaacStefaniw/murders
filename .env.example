# INTENT environment configuration.
# Copy to .env and fill in. Without these, the app runs in local demo mode:
# fully functional planning/adaptation on-device, no account sync, no AI narratives.

# Supabase project (Settings → API). The anon key is safe for the client;
# the service role key must NEVER appear here or anywhere in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Model API keys live ONLY in Supabase Edge Function secrets, never in the app:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
